{
  "manifest_version": 3,
  "name": "uLearn 压测插件",
  "version": "1.0.0",
  "description": "针对内网学习平台的压测 / 自动学习记录插件（MV3，纯原生 JS，无第三方框架）",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "storage", "declarativeNetRequest", "scripting", "tabs"],
  "host_permissions": [
    "*://*.ulearning.cn/*",
    "*://ulearning.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "uLearn 压测插件"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "origin_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
